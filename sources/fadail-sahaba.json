  "toc": [
    {
      "title": "( سئل عن فضائل أبي بكر الصديق رحمة الله عليه ورضوانه )",
      "part": 1,
      "row": 4,
      "offset": 0
    },
    {
      "title": "سئل عن قول علي بن أبي طالب وغيره خير هذه الأمة بعد نبيها أبو بكر وعمر",
      "part": 2,
      "row": 0,
      "offset": 0
    },
    {
      "title": "قوله صلى الله عليه وسلم لو كنت متخذا من الناس خليلا لاتخذت أبا بكر خليلا",
      "part": 3,
      "row": 4,
      "offset": 0
    },
    {
      "title": "قوله صلى الله عليه وسلم مروا أبا بكر فليصل بالناس",
      "part": 3,
      "row": 13,
      "offset": 0
    },
    {
      "title": "( بقية قوله مروا أبا بكر يصلي بالناس )",
      "part": 4,
      "row": 6,
      "offset": 0
    },
    {
      "title": "( أن أول من اسلم أبو بكر )",
      "part": 11,
      "row": 2,
      "offset": 177
    },
    {
      "title": "( ما روي ان أبا بكر جاء ليستأذن فقال النبي صلى الله عليه وسلم ائذن",
      "part": 11,
      "row": 11,
      "offset": 0
    },
    {
      "title": "( فضائل أمير المؤمنين عمر بن الخطاب رضي الله عنه )",
      "part": 12,
      "row": 8,
      "offset": 0
    },
    {
      "title": "( إسلام عمر بن الخطاب رضي الله عنه )",
      "part": 14,
      "row": 10,
      "offset": 362
    },
    {
      "title": "( باب خير هذه الأمة بعد نبيها )",
      "part": 16,
      "row": 3,
      "offset": 0
    },
    {
      "title": "( ومن فضائل عمر بن الخطاب من حديث أبي بكر بن مالك عن مشائخه غير",
      "part": 18,
      "row": 8,
      "offset": 0
    },
    {
      "title": "( فضائل عثمان بن عفان رضي الله عنه )",
      "part": 26,
      "row": 0,
      "offset": 0
    },
    {
      "title": "( ومن فضائل عثمان من حديث أبي بكر بن مالك عن شيوخه سوى عبد الله بن",
      "part": 29,
      "row": 9,
      "offset": 0
    },
    {
      "title": "( أخيار أمير المؤمنين علي بن أبي طالب وزهده رضوان الله عليه )",
      "part": 31,
      "row": 4,
      "offset": 0
    },
    {
      "title": "( نسب أمير المؤمنين علي بن أبي طالب رضي الله عنه )",
      "part": 32,
      "row": 11,
      "offset": 398
    },
    {
      "title": "( اسم أمه ونسبها )",
      "part": 32,
      "row": 14,
      "offset": 0
    },
    {
      "title": "( فضائل علي عليه السلام )",
      "part": 33,
      "row": 6,
      "offset": 0
    },
    {
      "title": "( ومن فضائل علي رضي الله عنه من حديث أبي بكر بن مالك عن شيوخه غير",
      "part": 36,
      "row": 6,
      "offset": 0
    },
    {
      "title": "( فضائل عبد الرحمن بن عوف رضي الله عنه )",
      "part": 44,
      "row": 1,
      "offset": 0
    },
    {
      "title": "( فضائل الزبير بن العوام رضي الله عنه )",
      "part": 44,
      "row": 6,
      "offset": 0
    },
    {
      "title": "( فضائل أبي عبيدة بن الجراح رضي الله عنه )",
      "part": 44,
      "row": 11,
      "offset": 211
    },
    {
      "title": "( فضائل طلحة بن عبيد الله رضي الله عنه )",
      "part": 45,
      "row": 1,
      "offset": 0
    },
    {
      "title": "( فضائل سعد بن أبي وقاص رضي الله عنه )",
      "part": 45,
      "row": 6,
      "offset": 0
    },
    {
      "title": "( فضائل فاطمة بنت رسول الله صلى الله عليه وسلم )",
      "part": 45,
      "row": 12,
      "offset": 425
    },
    {
