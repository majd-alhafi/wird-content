{"schema":1,"publisher":"Quranpedia.net","edition":{"id":1959,"name":"الترجمة التركية - مجمع الملك فهد","short_name":"الترجمة التركية - مجمع الملك فهد","description":"ترجمة معاني القرآن الكريم للغة التركية، ترجمها ممجموعة من العلماء، نشرها مجمع الملك فهد لطباعة المصحف الشريف بالمدينة المنورة، عام الطبعة 1422هـ. ملاحظة: ترجمات بعض الآيات (مشار إليها) تم تصويبها بمعرفة مركز رواد الترجمة، مع إتاحة الاطلاع على الترجمة الأصلية لغرض إبداء الرأي والتقييم والتطوير المستمر. ","language":"Türkçe","locale_code":"tr","direction":"ltr"},"rows":[{"sura":56,"aya":1,"translation":"Kıyamet koptuğu zaman,","sourcePage":534},{"sura":56,"aya":2,"translation":"ki onun oluşunu yalanlayacak hiçbir kimse yoktur;","sourcePage":534},{"sura":56,"aya":3,"translation":"O, alçaltıcı, yükselticidir.","sourcePage":534},{"sura":56,"aya":4,"translation":"Yer şiddetle sarsıldığı zaman,","sourcePage":534},{"sura":56,"aya":5,"translation":"Dağlar parçaladığı zaman,","sourcePage":534},{"sura":56,"aya":6,"translation":"dağılıp toz duman haline geldiği","sourcePage":534},{"sura":56,"aya":7,"translation":"ve sizler de üç sınıf olduğunuz zaman,","sourcePage":534},{"sura":56,"aya":8,"translation":"sağdakiler, ne mutlu o sağdakilere!","sourcePage":534},{"sura":56,"aya":9,"translation":"Soldakiler, ne bahtsızdırlar onlar!","sourcePage":534},{"sura":56,"aya":10,"translation":"(Hayırda) önde olanlar, (ecirde de) öndedirler.","sourcePage":534},{"sura":56,"aya":11,"translation":"İşte bunlar, (Allah'a) en yakın olanlardır.","sourcePage":534},{"sura":56,"aya":12,"translation":"Naîm cennetlerinde.","sourcePage":534},{"sura":56,"aya":13,"translation":"(Onların) çoğu önceki ümmetlerden,","sourcePage":534},{"sura":56,"aya":14,"translation":"birazı da sonrakilerdendir.","sourcePage":534},{"sura":56,"aya":15,"translation":"Cevherlerle işlenmiş tahtlar üzerindedir,","sourcePage":534},{"sura":56,"aya":16,"translation":"karşılıklı olarak oturup yaslanırlar.","sourcePage":534},{"sura":56,"aya":17,"translation":"Çevrelerinde, (hizmet için) ölümsüz gençler dolaşır;","sourcePage":535},{"sura":56,"aya":18,"translation":"Maîn çeşmesinden doldurulmuş testiler, ibrikler ve kadehlerle.","sourcePage":535},{"sura":56,"aya":19,"translation":"Bu şaraptan ne başları ağrıtılır, ne de akılları giderilir.","sourcePage":535},{"sura":56,"aya":20,"translation":"(Onlara) beğendikleri meyveler,","sourcePage":535},{"sura":56,"aya":21,"translation":"Canlarının çektiği kuş etleri,","sourcePage":535},{"sura":56,"aya":22,"translation":"iri gözlü huriler,","sourcePage":535},{"sura":56,"aya":23,"translation":"saklı inciler gibi","sourcePage":535},{"sura":56,"aya":24,"translation":"yaptıklarına karşılık olarak (verilir).","sourcePage":535},{"sura":56,"aya":25,"translation":"Orada boş bir söz ve günaha sokan bir laf işitmezler.","sourcePage":535},{"sura":56,"aya":26,"translation":"Söylenen, yalnızca <strong>«selâm, selâm »</strong>dır.","sourcePage":535},{"sura":56,"aya":27,"translation":"Sağdakiler, ne mutlu o sağdakilere (amel defteri sağdan verilenlere)!","sourcePage":535},{"sura":56,"aya":28,"translation":"Düzgün kiraz ağacı,","sourcePage":535},{"sura":56,"aya":29,"translation":"meyveleri salkım salkım dizili muz ağaçları,","sourcePage":535},{"sura":56,"aya":30,"translation":"uzamış gölgeler,","sourcePage":535},{"sura":56,"aya":31,"translation":"çağlayarak akan sular,","sourcePage":535},{"sura":56,"aya":32,"translation":"sayısız meyveler içindedirler;","sourcePage":535},{"sura":56,"aya":33,"translation":"Tükenmeyen ve yasaklanmayan, ","sourcePage":535},{"sura":56,"aya":34,"translation":"ve kabartılmış döşekler üstündedirler.","sourcePage":535},{"sura":56,"aya":35,"translation":"Gerçekten biz hurileri apayrı biçimde yeni yarattık.","sourcePage":535},{"sura":56,"aya":36,"translation":"Onları, eşlerine bâkireler kıldık.","sourcePage":535},{"sura":56,"aya":37,"translation":" Düşkün ve yaşıt.","sourcePage":535},{"sura":56,"aya":38,"translation":"Bütün bunlar sağdakiler içindir.","sourcePage":535},{"sura":56,"aya":39,"translation":"Bunların birçoğu önceki ümmetlerdendir.","sourcePage":535},{"sura":56,"aya":40,"translation":"Birçoğu da sonrakilerdendir.","sourcePage":535},{"sura":56,"aya":41,"translation":"Soldakiler; ne yazık o soldakilere (amel defteri soldan verilenlere)!","sourcePage":535},{"sura":56,"aya":42,"translation":"İçlerine işleyen bir ateş ve kaynar su içinde,","sourcePage":535},{"sura":56,"aya":43,"translation":"kapkara dumandan bir gölge altındadırlar,","sourcePage":535},{"sura":56,"aya":44,"translation":"serin ve hoş olmayan.","sourcePage":535},{"sura":56,"aya":45,"translation":"Çünkü onlar bundan önce varlık içinde sefahete dalmışlardı.","sourcePage":535},{"sura":56,"aya":46,"translation":"Büyük günahı işlemekte direnir dururlardı.","sourcePage":535},{"sura":56,"aya":47,"translation":"Ve diyorlardı ki: Biz öldükten, toprak ve kemik yığını haline geldikten sonra, biz mi bir daha diriltileceğiz?","sourcePage":535},{"sura":56,"aya":48,"translation":"Önceki atalarımız da mı?","sourcePage":535},{"sura":56,"aya":49,"translation":"De ki: Hem öncekiler hem de sonrakiler,","sourcePage":535},{"sura":56,"aya":50,"translation":"belli bir günün belli vaktinde mutlaka toplanacaklardır! ","sourcePage":535},{"sura":56,"aya":51,"translation":"Sonra siz ey sapıklar, yalancılar!","sourcePage":536},{"sura":56,"aya":52,"translation":"Elbette bir ağaçtan, zakkum ağacından yiyeceksiniz.","sourcePage":536},{"sura":56,"aya":53,"translation":"Karınlarınızı ondan dolduracaksınız.","sourcePage":536},{"sura":56,"aya":54,"translation":"Üstüne de kaynar sudan içeceksiniz.","sourcePage":536},{"sura":56,"aya":55,"translation":"Susamış develerin suya saldırışı gibi içeceksiniz.","sourcePage":536},{"sura":56,"aya":56,"translation":"İşte ceza gününde onlara sunulacak ziyafet budur!","sourcePage":536},{"sura":56,"aya":57,"translation":"Sizi biz yarattık. Tasdik etmeniz gerekmez mi?","sourcePage":536},{"sura":56,"aya":58,"translation":"Söyleyin öyleyse, (rahimlere) döktüğünüz meni nedir?","sourcePage":536},{"sura":56,"aya":59,"translation":"Onu siz mi yaratıyorsunuz yoksa yaratan biz miyiz?","sourcePage":536},{"sura":56,"aya":60,"translation":"Aranızda ölümü takdir eden biziz ve biz, önüne geçilebileceklerden değiliz.","sourcePage":536},{"sura":56,"aya":61,"translation":"Böylece sizin yerinize benzerlerinizi getirelim ve sizi bilmediğiniz bir âlemde tekrar var edelim diye (ölümü takdir ettik).","sourcePage":536},{"sura":56,"aya":62,"translation":"Andolsun, ilk yaratılışı bildiniz. Düşünüp ibret almanız gerekmez mi?","sourcePage":536},{"sura":56,"aya":63,"translation":"Şimdi bana, ektiğinizi haber verin.","sourcePage":536},{"sura":56,"aya":64,"translation":"Onu siz mi bitiriyorsunuz, yoksa bitiren biz miyiz?","sourcePage":536},{"sura":56,"aya":65,"translation":"Dileseydik onu kuru bir çöp yapardık da şaşar kalırdınız.","sourcePage":536},{"sura":56,"aya":66,"translation":"«Doğrusu borç altına girdik.","sourcePage":536},{"sura":56,"aya":67,"translation":"Daha doğrusu, biz yoksul kaldık» (derdiniz).","sourcePage":536},{"sura":56,"aya":68,"translation":"Ya içtiğiniz suya ne dersiniz?","sourcePage":536},{"sura":56,"aya":69,"translation":"Buluttan onu siz mi indirdiniz, yoksa indiren biz miyiz?","sourcePage":536},{"sura":56,"aya":70,"translation":"Dileseydik onu tuzlu yapardık. Şükretmeniz gerekmez mi?","sourcePage":536},{"sura":56,"aya":71,"translation":"Söyleyin şimdi bana, tutuşturmakta olduğunuz ateşi,","sourcePage":536},{"sura":56,"aya":72,"translation":"onun ağacını siz mi yarattınız, yoksa yaratan biz miyiz?","sourcePage":536},{"sura":56,"aya":73,"translation":"Biz onu bir ibret ve çölden gelip geçenlerin istifadesi için yarattık.","sourcePage":536},{"sura":56,"aya":74,"translation":"Öyleyse Yüce Rabbinin adıyla tesbih et.","sourcePage":536},{"sura":56,"aya":75,"translation":"Hayır! Yıldızların yerlerine yemin ederim ki,","sourcePage":536},{"sura":56,"aya":76,"translation":"Bilirseniz, gerçekten bu, büyük bir yemindir. ","sourcePage":536},{"sura":56,"aya":77,"translation":"Değerli bir Kur'an'dır.","sourcePage":537},{"sura":56,"aya":78,"translation":"Şüphesiz bu, korunmuş bir kitapta bulunan ","sourcePage":537},{"sura":56,"aya":79,"translation":"Ona ancak temizlenenler dokunabilir.","sourcePage":537},{"sura":56,"aya":80,"translation":"O, âlemlerin Rabbinden indirilmiştir.","sourcePage":537},{"sura":56,"aya":81,"translation":"Şimdi siz, bu sözü mü küçümsüyorsunuz?","sourcePage":537},{"sura":56,"aya":82,"translation":"Allah’ın verdiği rızka karşı şükrü, onu yalanlamakla mı yerine getiriyorsunuz?","sourcePage":537},{"sura":56,"aya":83,"translation":"Hele can boğaza dayandığı zaman,","sourcePage":537},{"sura":56,"aya":84,"translation":"O vakit siz bakar durursunuz.","sourcePage":537},{"sura":56,"aya":85,"translation":"(O anda) biz ona sizden daha yakınız, ama göremezsiniz.","sourcePage":537},{"sura":56,"aya":86,"translation":"Madem ki ceza görmeyecekmişsiniz,","sourcePage":537},{"sura":56,"aya":87,"translation":"Onu (canı) geri çevirsenize, şayet iddianızda doğru iseniz!","sourcePage":537},{"sura":56,"aya":88,"translation":"Fakat (ölen kişi Allah'a) yakın olanlardan ise,","sourcePage":537},{"sura":56,"aya":89,"translation":"ona rahatlık, güzel rızık ve Naîm cenneti vardır.","sourcePage":537},{"sura":56,"aya":90,"translation":"Eğer o sağdakilerden ise,","sourcePage":537},{"sura":56,"aya":91,"translation":"<strong>«Ey sağdaki! Sana selam olsun!»</strong>","sourcePage":537},{"sura":56,"aya":92,"translation":"Ama yalanlayan sapıklardan ise,","sourcePage":537},{"sura":56,"aya":93,"translation":"İşte ona da kaynar sudan bir ziyafet vardır!","sourcePage":537},{"sura":56,"aya":94,"translation":"Ve (onun sonu) cehenneme atılmaktır.","sourcePage":537},{"sura":56,"aya":95,"translation":"Şüphesiz ki bu, kesin gerçektir.","sourcePage":537},{"sura":56,"aya":96,"translation":"O halde Yüce Rabbinin adıyla tesbîh et.","sourcePage":537}]}