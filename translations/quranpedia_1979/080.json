{"schema":1,"publisher":"Quranpedia.net","edition":{"id":1979,"name":"الترجمة الكازاخية - مجمع الملك فهد","short_name":"الترجمة الكازاخية - مجمع الملك فهد","description":"ترجمة معاني القرآن الكريم للغة الكازاخية ترجمها خليفة الطاي، نشرها مجمع الملك فهد لطباعة المصحف الشريف. عام الطبعة 1412هـ. ملاحظة: ترجمات بعض الآيات (مشار إليها) تم تصويبها بمعرفة مركز رواد الترجمة، مع إتاحة الاطلاع على الترجمة الأصلية لغرض إبداء الرأي والتقييم والتطوير المستمر. ","language":"Қазақша","locale_code":"kk","direction":"ltr"},"rows":[{"sura":80,"aya":1,"translation":"Қабақ шытып,бет бұрды; ","sourcePage":585},{"sura":80,"aya":2,"translation":"Оған соқырдың келуімен. ","sourcePage":585},{"sura":80,"aya":3,"translation":"Қайдан білесің,мүмкін ол тазарар?","sourcePage":585},{"sura":80,"aya":4,"translation":"Не үгіт алар,оған үгіт пайда берер. ","sourcePage":585},{"sura":80,"aya":5,"translation":"Ал енді байсынған;(Құрайш бастықтары) келсе,","sourcePage":585},{"sura":80,"aya":6,"translation":"Оған көңіл бөлесің. ","sourcePage":585},{"sura":80,"aya":7,"translation":"Ол тазармаса саған не? ","sourcePage":585},{"sura":80,"aya":8,"translation":"Ал енді саған жұгіріп келген біреу;","sourcePage":585},{"sura":80,"aya":9,"translation":"Ол,(Алладан) қорқады. ","sourcePage":585},{"sura":80,"aya":10,"translation":"Сонда да оған селқос қарайсың. ","sourcePage":585},{"sura":80,"aya":11,"translation":"Жоқ,олай емес.Әлбетте Құран бір насихат. ","sourcePage":585},{"sura":80,"aya":12,"translation":"Сондықтан кім қаласа,үгіт алады. ","sourcePage":585},{"sura":80,"aya":13,"translation":"Құрметті нұсқаларда жазулы, ","sourcePage":585},{"sura":80,"aya":14,"translation":"Жоғары бағаланған тап-таза; ","sourcePage":585},{"sura":80,"aya":15,"translation":"Елшілердің қолында,","sourcePage":585},{"sura":80,"aya":16,"translation":"Ардақта,игі.(Періштелер;Лаухы Махфуздан көшірген.Б.Ж.Х) ","sourcePage":585},{"sura":80,"aya":17,"translation":"Жаны шықсын) Оған,адам баласы қалай қарсы?","sourcePage":585},{"sura":80,"aya":18,"translation":"Алла адамды не нәрседен жаратты? ","sourcePage":585},{"sura":80,"aya":19,"translation":"Бір тамшыдан жаратып,оны бейнеледі. ","sourcePage":585},{"sura":80,"aya":20,"translation":"Сосын оның жолын оңайластырды. ","sourcePage":585},{"sura":80,"aya":21,"translation":"Кейін оған өлім біріп,оны қабырға қойдырды. ","sourcePage":585},{"sura":80,"aya":22,"translation":"Қалаған сәтте,оны тірілтеді. ","sourcePage":585},{"sura":80,"aya":23,"translation":"Жоқ,ол Алланың әмірін орындамады. ","sourcePage":585},{"sura":80,"aya":24,"translation":"Ал енді адамзат,жеген тамағына бір көз салсын.","sourcePage":585},{"sura":80,"aya":25,"translation":"Әрине мол су бердік. ","sourcePage":585},{"sura":80,"aya":26,"translation":"Сосын қара жерді қақ айырдық. ","sourcePage":585},{"sura":80,"aya":27,"translation":"Сонда жерде дәнді дақылдар өсірдік.","sourcePage":585},{"sura":80,"aya":28,"translation":"Жүзімдер,жоңышқалар, ","sourcePage":585},{"sura":80,"aya":29,"translation":"Зәйтіндер,құрмалар, ","sourcePage":585},{"sura":80,"aya":30,"translation":"Ну бақшалар, ","sourcePage":585},{"sura":80,"aya":31,"translation":"Жемістер,өлеңдер; ","sourcePage":585},{"sura":80,"aya":32,"translation":"Сендер әрі малдарың пайдалану үшін. ","sourcePage":585},{"sura":80,"aya":33,"translation":" Ал енді қатты дауыс келген сәтте; ","sourcePage":585},{"sura":80,"aya":34,"translation":"Сол күні,кісі туысынан қашады; ","sourcePage":585},{"sura":80,"aya":35,"translation":"Шешесінен,әкесінен ","sourcePage":585},{"sura":80,"aya":36,"translation":"Әйелінен және балаларынан. ","sourcePage":585},{"sura":80,"aya":37,"translation":"Ол күні әркімнің ісі ауыр.(Әркім өз халымен әлек.) ","sourcePage":585},{"sura":80,"aya":38,"translation":"Ол күні кейбір жүздер,жарқырайды, ","sourcePage":585},{"sura":80,"aya":39,"translation":"Күлген қуанышты.","sourcePage":585},{"sura":80,"aya":40,"translation":"Ол күні кейбір жүздің үстін шаң басқан болады; ","sourcePage":585},{"sura":80,"aya":41,"translation":"Оны қара түнек қаптаған болады. ","sourcePage":586},{"sura":80,"aya":42,"translation":"Міне солар,қарсы келген бұзақылар. ","sourcePage":586}]}