{"schema":1,"publisher":"Quranpedia.net","edition":{"id":1959,"name":"الترجمة التركية - مجمع الملك فهد","short_name":"الترجمة التركية - مجمع الملك فهد","description":"ترجمة معاني القرآن الكريم للغة التركية، ترجمها ممجموعة من العلماء، نشرها مجمع الملك فهد لطباعة المصحف الشريف بالمدينة المنورة، عام الطبعة 1422هـ. ملاحظة: ترجمات بعض الآيات (مشار إليها) تم تصويبها بمعرفة مركز رواد الترجمة، مع إتاحة الاطلاع على الترجمة الأصلية لغرض إبداء الرأي والتقييم والتطوير المستمر. ","language":"Türkçe","locale_code":"tr","direction":"ltr"},"rows":[{"sura":81,"aya":1,"translation":"Güneş katlanıp dürüldüğünde,","sourcePage":586},{"sura":81,"aya":2,"translation":"Yıldızlar (kararıp) döküldüğünde,","sourcePage":586},{"sura":81,"aya":3,"translation":"Dağlar (sallanıp) yürütüldüğünde,","sourcePage":586},{"sura":81,"aya":4,"translation":"Gebe develer salıverildiğinde,","sourcePage":586},{"sura":81,"aya":5,"translation":"Vahşî hayvanlar toplanıp bir araya getirildiğinde,","sourcePage":586},{"sura":81,"aya":6,"translation":"Denizler kaynatıldığında,","sourcePage":586},{"sura":81,"aya":7,"translation":"Ruhlar (bedenlerle) birleştirildiğinde,","sourcePage":586},{"sura":81,"aya":8,"translation":"Diri diri toprağa gömülen kıza, sorulduğunda,","sourcePage":586},{"sura":81,"aya":9,"translation":"hangi günah sebebiyle öldürüldüğü,","sourcePage":586},{"sura":81,"aya":10,"translation":"(Amellerin yazılı olduğu) defterler açıldığında,","sourcePage":586},{"sura":81,"aya":11,"translation":"Gökyüzü sıyrılıp alındığında,","sourcePage":586},{"sura":81,"aya":12,"translation":"cehennem tutuşturulduğunda ","sourcePage":586},{"sura":81,"aya":13,"translation":"ve cennet yaklaştırıldığında,","sourcePage":586},{"sura":81,"aya":14,"translation":"Kişi neler getirdiğini öğrenmiş olacaktır.","sourcePage":586},{"sura":81,"aya":15,"translation":"Hayır! (Gündüz) sinen, ","sourcePage":586},{"sura":81,"aya":16,"translation":"akıp giden, etrafı aydınlatan yıldızlara andolsun,","sourcePage":586},{"sura":81,"aya":17,"translation":"Kararmaya yüz tuttuğunda geceye andolsun,","sourcePage":586},{"sura":81,"aya":18,"translation":"Ağarmaya başladığında sabaha andolsun ki,","sourcePage":586},{"sura":81,"aya":19,"translation":"itibarlı bir elçinin (Cebrail'in) getirdiği sözdür.","sourcePage":586},{"sura":81,"aya":20,"translation":"O (Kur'an), şüphesiz değerli, güçlü ve Arş'ın sahibi (Allah'ın) katında ","sourcePage":586},{"sura":81,"aya":21,"translation":"O orada sayılan, güvenilen (elçi)'dir. ","sourcePage":586},{"sura":81,"aya":22,"translation":"Arkadaşınız (Muhammed) de mecnun değildir. ","sourcePage":586},{"sura":81,"aya":23,"translation":"Andolsun ki, onu (Cebrail'i) apaçık ufukta görmüştür. ","sourcePage":586},{"sura":81,"aya":24,"translation":"O, gaybın bilgilerini (sizden) esirgemez. ","sourcePage":586},{"sura":81,"aya":25,"translation":"O lanetlenmiş şeytanın sözü de değildir. ","sourcePage":586},{"sura":81,"aya":26,"translation":"Hal böyle iken nereye gidiyorsunuz? ","sourcePage":586},{"sura":81,"aya":27,"translation":"O, herkes için, bir öğüttür. ","sourcePage":586},{"sura":81,"aya":28,"translation":" Sizden doğru yolda gitmek isteyenler için.","sourcePage":586},{"sura":81,"aya":29,"translation":"Âlemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz.","sourcePage":586}]}