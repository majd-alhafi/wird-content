{"schema":1,"publisher":"Quranpedia.net","edition":{"id":1979,"name":"الترجمة الكازاخية - مجمع الملك فهد","short_name":"الترجمة الكازاخية - مجمع الملك فهد","description":"ترجمة معاني القرآن الكريم للغة الكازاخية ترجمها خليفة الطاي، نشرها مجمع الملك فهد لطباعة المصحف الشريف. عام الطبعة 1412هـ. ملاحظة: ترجمات بعض الآيات (مشار إليها) تم تصويبها بمعرفة مركز رواد الترجمة، مع إتاحة الاطلاع على الترجمة الأصلية لغرض إبداء الرأي والتقييم والتطوير المستمر. ","language":"Қазақша","locale_code":"kk","direction":"ltr"},"rows":[{"sura":56,"aya":1,"translation":"Қиямет уақиғасы болған кезде, ","sourcePage":534},{"sura":56,"aya":2,"translation":"Оның болуын өтірік деуші болмас. ","sourcePage":534},{"sura":56,"aya":3,"translation":"(Ол) төмендетеді, жоғарлатады.","sourcePage":534},{"sura":56,"aya":4,"translation":"Сол уақытта жер тұтас сілкіндіріледі. ","sourcePage":534},{"sura":56,"aya":5,"translation":"Таулар мүлде үгітіледі.","sourcePage":534},{"sura":56,"aya":6,"translation":"Ұшқан тозаңдай болады. ","sourcePage":534},{"sura":56,"aya":7,"translation":"Сол уақытта сендер үш бөлімге бөлінесіңдер; ","sourcePage":534},{"sura":56,"aya":8,"translation":"(Ғамал дәптері оңынан берілген) оңшылдар, нендей жақсы ол оңшылдар. ","sourcePage":534},{"sura":56,"aya":9,"translation":"(Ғамал дәптері солынан берілген) солшылдар, нендей жаман ол солшылдар.","sourcePage":534},{"sura":56,"aya":10,"translation":"Озаттар алдынғы қатарда болады.","sourcePage":534},{"sura":56,"aya":11,"translation":"Міне солар, Аллаға жақын болғандар. ","sourcePage":534},{"sura":56,"aya":12,"translation":"Ұжмақта нығметке бөленеді; ","sourcePage":534},{"sura":56,"aya":13,"translation":"Бұрынғылардан көбірек. ","sourcePage":534},{"sura":56,"aya":14,"translation":"Соңғылардан азырақ. ","sourcePage":534},{"sura":56,"aya":15,"translation":"Безенген тақтар үстінде. ","sourcePage":534},{"sura":56,"aya":16,"translation":"Олардың үстінде ерсілі-қарсылы отырады.","sourcePage":534},{"sura":56,"aya":17,"translation":"Оларға өзгермес жастар айналып, қызмет етеді;","sourcePage":535},{"sura":56,"aya":18,"translation":"Ағып жатқан арақтан толтырылған шелектер, құмандар және кәселерменен. ","sourcePage":535},{"sura":56,"aya":19,"translation":"Ол; бас ауыртпайды да мас қылмайды. ","sourcePage":535},{"sura":56,"aya":20,"translation":"Қалаған жемістері бар. ","sourcePage":535},{"sura":56,"aya":21,"translation":"Көңілдері соққан құс еті бар. ","sourcePage":535},{"sura":56,"aya":22,"translation":"Бота көз хұрлар бар. ","sourcePage":535},{"sura":56,"aya":23,"translation":"Сақтаулы інжу сияқты. ","sourcePage":535},{"sura":56,"aya":24,"translation":"Бұл істеген ғамалдарының сыйлығы. ","sourcePage":535},{"sura":56,"aya":25,"translation":"Олар жаннатта бос не күнәлы сөз естімейді.","sourcePage":535},{"sura":56,"aya":26,"translation":"Бірақ \"Сәлем, сәлем\" деген сөзді ғана естиді. ","sourcePage":535},{"sura":56,"aya":27,"translation":"Оңшылдар, ол оңшылдар нендей бақытты. ","sourcePage":535},{"sura":56,"aya":28,"translation":"Олар тікенсіз сидыр (ағаштары); ","sourcePage":535},{"sura":56,"aya":29,"translation":"Жемістері үсті-үстіне шоғырланған мұз (банан) ағаштарының, ","sourcePage":535},{"sura":56,"aya":30,"translation":"Созылған көлеңкенің астында болады.","sourcePage":535},{"sura":56,"aya":31,"translation":"Сарқырап аққан су бар. ","sourcePage":535},{"sura":56,"aya":32,"translation":"Мол жеміс бар; ","sourcePage":535},{"sura":56,"aya":33,"translation":"Ешбір түгеп, үзілмейтін, ешкім қорымайтын, ","sourcePage":535},{"sura":56,"aya":34,"translation":"Биік төсектерде болады. ","sourcePage":535},{"sura":56,"aya":35,"translation":"Расында хұр қыздарын жаңадан жаратамыз. (Немесе жаннаттық әйелдерді қайтадан жаратамыз.Б.) ","sourcePage":535},{"sura":56,"aya":36,"translation":"Оларды ер көрмеген қыздар етіп, жаратамыз. ","sourcePage":535},{"sura":56,"aya":37,"translation":"Күйеуін сүйгіш құрдас болады. ","sourcePage":535},{"sura":56,"aya":38,"translation":"Бұл айтылғандар, оңшылдар үшін болады. ","sourcePage":535},{"sura":56,"aya":39,"translation":"Бір топ бұрынғылардан. ","sourcePage":535},{"sura":56,"aya":40,"translation":"Бір топ соңғылардан.","sourcePage":535},{"sura":56,"aya":41,"translation":"Солшылдар, сол шолшылдар невдей сұмырай. ","sourcePage":535},{"sura":56,"aya":42,"translation":"Олар ыстық бу, қайнар суда болады. ","sourcePage":535},{"sura":56,"aya":43,"translation":"Қара түнек көлеңкеде болады. ","sourcePage":535},{"sura":56,"aya":44,"translation":"Салқын да емес, жайлы да емес. ","sourcePage":535},{"sura":56,"aya":45,"translation":"Өйткені олар, бұдан бұрын (дүниеде) тоң мойын әуесқорлар еді. ","sourcePage":535},{"sura":56,"aya":46,"translation":"Зор күнәда қасарысушы еді.","sourcePage":535},{"sura":56,"aya":47,"translation":"\"Өліп, топырақ және сүйектер болсақ та шын тірілеміз бе?\",- дейді.","sourcePage":535},{"sura":56,"aya":48,"translation":"\"Бұрынғы аталарымыз да тіріле ме?\",- (дейді.) ","sourcePage":535},{"sura":56,"aya":49,"translation":"(Мұхаммед Ғ.С.): \"Сөзсіз бұрынғылар да, соңғылар да.\",- де.","sourcePage":535},{"sura":56,"aya":50,"translation":"\"Әлбетте, мәлім күнде белгілі орынға жиналады\" (де.)","sourcePage":535},{"sura":56,"aya":51,"translation":"Сосын сендер әй адасқан өтірікшілер! ","sourcePage":536},{"sura":56,"aya":52,"translation":"Әлбетте ағаштан, Заққұмнан жейсіңдер. ","sourcePage":536},{"sura":56,"aya":53,"translation":"Одан қарындарыңды толтырасыңдар. ","sourcePage":536},{"sura":56,"aya":54,"translation":"Оның үстіне қайнар судан ішесіңдер.","sourcePage":536},{"sura":56,"aya":55,"translation":"Шөлдеген түйеше, сіміресіңдер. ","sourcePage":536},{"sura":56,"aya":56,"translation":"Міне олардың қиямет күнгі сыйлықтары.","sourcePage":536},{"sura":56,"aya":57,"translation":"Сендерді Біз жараттық. Сонда неге мойындамайсыңдар? ","sourcePage":536},{"sura":56,"aya":58,"translation":"Сендер тамызған мәни суын көрдіңдер ме? ","sourcePage":536},{"sura":56,"aya":59,"translation":"Оны сендер жаратасыңдар ма? Немесе Біз жаратмыз ба? ","sourcePage":536},{"sura":56,"aya":60,"translation":"Біз араларыңда өлімді белгіледік. Бізден ешкім озалмайды. ","sourcePage":536},{"sura":56,"aya":61,"translation":"Сендердің бейнелеріңді өзгертіп, сендер білмегенді жарата аламыз. ","sourcePage":536},{"sura":56,"aya":62,"translation":"Расында бұрынғы жаратуды білесіңдер, ендеше түсінбейсіңдер ме? ","sourcePage":536},{"sura":56,"aya":63,"translation":"Ал енді еккендеріңді көрдіңдер ме?","sourcePage":536},{"sura":56,"aya":64,"translation":"Оны сендер өсіресіңдер ме? Не Біз өсіреміз бе? ","sourcePage":536},{"sura":56,"aya":65,"translation":"Егер қаласақ, оны қоқымға айналдырар едік. Сонда күңкілдесе берер едіңдер; ","sourcePage":536},{"sura":56,"aya":66,"translation":"\"Расында зиянға ұшырадық,\"","sourcePage":536},{"sura":56,"aya":67,"translation":"\"Тіпті мүлде бос қалдық\" (дер едіңдер.) ","sourcePage":536},{"sura":56,"aya":68,"translation":"Ішкен суларыңды көрдіңдер ме?","sourcePage":536},{"sura":56,"aya":69,"translation":"Оны бұлттан сендер жаудырасыңдар ма? Немесе Біз жаудырамыз ба?","sourcePage":536},{"sura":56,"aya":70,"translation":"Егер қаласақ оны ащы қылар едік. Ендеше, шүкір етпейсіңдер ме? ","sourcePage":536},{"sura":56,"aya":71,"translation":"Жаққан оттарыңды көрдіңдер ме?","sourcePage":536},{"sura":56,"aya":72,"translation":"Оның ағашын сендер жараттыңдар ма? немесе Біз жараттық па? ","sourcePage":536},{"sura":56,"aya":73,"translation":"Біз оны бір ескерткіш және жүргіншілер үшін пайдалы қылдық. ","sourcePage":536},{"sura":56,"aya":74,"translation":"(Мұхаммед Ғ.С.) Ендеше Раббыңды ұлы атымен дәріпте. ","sourcePage":536},{"sura":56,"aya":75,"translation":"Ал енді жұлдыздардың орындарына серт етемін.","sourcePage":536},{"sura":56,"aya":76,"translation":"Егер білсеңдер, ол, зор серт. ","sourcePage":536},{"sura":56,"aya":77,"translation":"Шын мәнінде ол ардақты Құран.","sourcePage":537},{"sura":56,"aya":78,"translation":"Кітапта (Лаухы Махфүзда. Б.М.Р.) сақтаулы. ","sourcePage":537},{"sura":56,"aya":79,"translation":"Оны тап-таза болғандар ғана ұстайды. (Дәретсіз кісі ұстамайды.) ","sourcePage":537},{"sura":56,"aya":80,"translation":"Әлемдердің Раббы жақтан түсірілген.","sourcePage":537},{"sura":56,"aya":81,"translation":"Сендер осы сөзді құр көресіңдер ме? ","sourcePage":537},{"sura":56,"aya":82,"translation":"Расында берген ризыққа шүкір етудің орнына оны жасынға шығарасыңдар ма? (Ж.) ","sourcePage":537},{"sura":56,"aya":83,"translation":"Ал жан жұтқыншаққа келген кезде;","sourcePage":537},{"sura":56,"aya":84,"translation":"Сол уақытта сендер қарап қаласыңдар. ","sourcePage":537},{"sura":56,"aya":85,"translation":"Негізінде ол өліп бара жатқанға Біз жақынырақпыз. Сендер көрмейсіңдер.","sourcePage":537},{"sura":56,"aya":86,"translation":"Ал сонда егер жазаланбайтын болсаңдар; ","sourcePage":537},{"sura":56,"aya":87,"translation":"Егер шын айтсаңдар, оның жанын қайтарыңдаршы. ","sourcePage":537},{"sura":56,"aya":88,"translation":"Ал егер өлген кісі, Аллаға жақындардан болса; ","sourcePage":537},{"sura":56,"aya":89,"translation":"Сонда оған рахатты шаттық әрі нығметті ұжмақ бар. ","sourcePage":537},{"sura":56,"aya":90,"translation":"Ал енді өлі оңшылдардан болса; ","sourcePage":537},{"sura":56,"aya":91,"translation":"Саған оңшылдардан, \"Сәлем\" (делінеді.) ","sourcePage":537},{"sura":56,"aya":92,"translation":"Егер өлі, жасынға шығарушы адасқандардан болса; ","sourcePage":537},{"sura":56,"aya":93,"translation":"Сонда оның қонақ асысы, қайнар судан болады.","sourcePage":537},{"sura":56,"aya":94,"translation":"Әрі тозаққа салынады.","sourcePage":537},{"sura":56,"aya":95,"translation":"Сөзсіз міне анық шындық осы. ","sourcePage":537},{"sura":56,"aya":96,"translation":"(Мұхаммед Ғ.С.) үлы Раббыңды атымен дәріпте. ","sourcePage":537}]}