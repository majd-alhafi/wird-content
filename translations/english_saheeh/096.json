{"schema":1,"publisher":"QuranEnc.com","edition":{"key":"english_saheeh","direction":"ltr","language_iso_code":"en","version":"1.1.2","last_update":1750772247,"title":"English Translation - Noor International Center","description":"Issued by Noor International Center.","file":"english_saheeh","database_url":"https://quranenc.com/downloads/sqlite/english_saheeh.zip","database_uncompressed_url":"https://quranenc.com/downloads/sqlite/english_saheeh.sqlite","pdf_url":null,"pdf_size":null,"pdf_cover":null,"pdf_pure_url":null,"pdf_pure_size":null,"pdf_pure_cover":null,"pdf_mobile_url":null,"pdf_mobile_size":null,"pdf_mobile_cover":null,"epub_url":null,"epub_size":null},"rows":[{"id":6107,"sura":96,"aya":1,"translation":"(1) Recite in the name of your Lord who created –","footnotes":""},{"id":6108,"sura":96,"aya":2,"translation":"(2) Created man from a clinging substance.","footnotes":""},{"id":6109,"sura":96,"aya":3,"translation":"(3) Recite, and your Lord is the most Generous -","footnotes":""},{"id":6110,"sura":96,"aya":4,"translation":"(4) Who taught by the pen –","footnotes":""},{"id":6111,"sura":96,"aya":5,"translation":"(5) Taught man that which he knew not.","footnotes":""},{"id":6112,"sura":96,"aya":6,"translation":"(6) No! [But] indeed, man transgresses","footnotes":""},{"id":6113,"sura":96,"aya":7,"translation":"(7) Because he sees himself self-sufficient.","footnotes":""},{"id":6114,"sura":96,"aya":8,"translation":"(8) Indeed, to your Lord is the return.","footnotes":""},{"id":6115,"sura":96,"aya":9,"translation":"(9) Have you seen the one who forbids","footnotes":""},{"id":6116,"sura":96,"aya":10,"translation":"(10) A servant when he prays?","footnotes":""},{"id":6117,"sura":96,"aya":11,"translation":"(11) Have you seen if he is upon guidance","footnotes":""},{"id":6118,"sura":96,"aya":12,"translation":"(12) Or enjoins righteousness?","footnotes":""},{"id":6119,"sura":96,"aya":13,"translation":"(13) Have you seen if he denies and turns away -","footnotes":""},{"id":6120,"sura":96,"aya":14,"translation":"(14) Does he not know that Allāh sees?","footnotes":""},{"id":6121,"sura":96,"aya":15,"translation":"(15) No! If he does not desist, We will surely drag him by the forelock[1952] –","footnotes":"[1952]- It may also mean \"slap him\" or \"blacken his face at the forelock.\""},{"id":6122,"sura":96,"aya":16,"translation":"(16) A lying, sinning forelock.","footnotes":""},{"id":6123,"sura":96,"aya":17,"translation":"(17) Then let him call his associates;","footnotes":""},{"id":6124,"sura":96,"aya":18,"translation":"(18) We will call the angels of Hell.[1953]","footnotes":"[1953]- Those who push the wicked into the Fire."},{"id":6125,"sura":96,"aya":19,"translation":"(19) No! Do not obey him. But prostrate and draw near [to Allāh].","footnotes":""}]}