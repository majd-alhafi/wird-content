leasant life[3].","footnotes":"[3] In Paradise."},{"id":6165,"sura":101,"aya":8,"translation":"But the one whose scales of good deeds are light,","footnotes":""},{"id":6166,"sura":101,"aya":9,"translation":"his abode will be the abyss[4].","footnotes":"[4] Hāwiyah: the pit of Hellfire."},{"id":6167,"sura":101,"aya":10,"translation":"And how do you know what it is?","footnotes":""},{"id":6168,"sura":101,"aya":11,"translation":"It is a Blazing Fire.","footnotes":""}]}